  # ── Cloudflare Tunnel (machine sidecar) ───────────────────────
  # Metrics (/ready, /config) are reachable on the HOST at 127.0.0.1:20241 only; the host security
  # scan reads the live ingress rules from /config to check Cloudflare Access on every hostname.
  cloudflared:
    image: cloudflare/cloudflared:2026.10.7
    container_name: {{stack.projectName}}-cloudflared
    restart: unless-stopped
{{#if stack.cloudflared.hostNetwork}}
    command: tunnel --metrics 127.0.0.1:20241 run
{{else}}
    command: tunnel --metrics 0.0.0.0:20241 run
{{/if}}
    environment:
      - TUNNEL_TOKEN={{stack.cloudflared.tunnelToken}}
{{#if stack.cloudflared.hostNetwork}}
    # Host networking — tunnel ingress routes reach host processes directly,
    # e.g. http://localhost:4040 for a service listening on 127.0.0.1 of the host.
    network_mode: host
{{else}}
    # Bridge network — tunnel ingress routes reach other services by their
    # Docker container name (e.g. http://my-service:8080).
    # Static IP so any trustedProxies config stays stable.
    networks:
      stack-net:
        ipv4_address: 10.200.0.100
    ports:
      - "127.0.0.1:20241:20241"   # metrics, host loopback only
{{/if}}
    read_only: true
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 128M
