{
  "name": "airstack",
  "type": "module",
  "private": true,
  "bin": {
    "airstack": "./bin/airstack.sh"
  },
  "scripts": {
    "airstack": "bun cli/index.ts",
    "deploy": "bun cli/deploy.ts",
    "status": "bun cli/status.ts",
    "stacks": "bun cli/stacks.ts",
    "logs": "bun cli/logs.ts",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "typecheck": "bunx tsc --noEmit",
    "bump-usage-server": "sh devutils/bump-usage-server.sh"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@vitest/coverage-v8": "3.2.4",
    "vitest": "^3.2.4"
  }
}