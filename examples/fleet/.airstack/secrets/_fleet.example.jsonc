{
  // Secrets template. Placeholder values only: this file is safe to commit.
  //
  // To use it:
  //   cp .airstack/secrets/_fleet.example.jsonc .airstack/secrets/_fleet.jsonc
  //   chmod 600 .airstack/secrets/_fleet.jsonc
  // then put your real values in _fleet.jsonc. Never commit _fleet.jsonc or <machine>.jsonc.
  //
  // airstack reads two files, in this order (the second one wins):
  //   .airstack/secrets/_fleet.jsonc      values shared by every machine
  //   .airstack/secrets/<machine>.jsonc   values for one machine (for example web-1.jsonc)
  //
  // Format: JSONC (JSON with comments and trailing commas), a flat map of NAME: value.
  // Values are strings, numbers or booleans. Config files use them as ${NAME} or ${NAME:-default}.

  // Cloudflare Tunnel token (Zero Trust dashboard > Networks > Tunnels > your tunnel > token).
  "CLOUDFLARE_TUNNEL_TOKEN": "replace-with-your-tunnel-token",

  // Telegram alerts from the host crons (docs/TELEGRAM.md).
  "HOSTALERT_TELEGRAM_BOT_TOKEN": "replace-with-your-bot-token",
  "HOSTALERT_TELEGRAM_CHAT_ID": "-1000000000000",
}
