.DS_Store
node_modules/
coverage/
dist/
tmp/

# Fleet state (secrets, staged deploy trees, logs, reports). This repo is the airstack core:
# real fleet config lives in a separate fleet repo and never here. Test fleets go under
# test/fixtures/ with documentation-only values.
.airstack/
.env
.env.*
# ...but plugin templates named .env.hbs are source code
!cli/plugins/*/templates/.env.hbs

# Test fleets keep their (fake) secrets under version control
!test/fixtures/*/.airstack/
*.bun-build
